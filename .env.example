# Illuminate POC Backend - Environment Configuration
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# CDK reads the COGNITO_* values during deployment. The SNOWFLAKE_* values go to a tenant's
# Secrets Manager secret with scripts/set-snowflake-secret.sh <tenant_id>.

# Snowflake credentials
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=SVC_BLACKBOARD_DATA
SNOWFLAKE_PASSWORD=your-password
SNOWFLAKE_WAREHOUSE=BLACKBOARD_DATA_WH
SNOWFLAKE_ROLE=BBDATA_USER_ROLE

# Tenant of the Cognito initial user. Required for that user; set it before any base-stack deploy.
# Snowflake credentials above go to a tenant's secret: scripts/set-snowflake-secret.sh <tenant_id>
INITIAL_TENANT_ID=

# Cognito initial user (created during first deploy)
COGNITO_USER_EMAIL=admin@example.com
COGNITO_USER_PASSWORD=YourSecurePassword123!
COGNITO_USER_NAME=Your Name

# AWS configuration (optional)
# AWS_REGION=us-east-1
